# Production database — copy to `.env.production` (gitignored) for one-off CLI tasks.
# For the live app, set the same values in Vercel → Environment Variables → Production.

DATABASE_URL="postgresql://user:password@prod-host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@prod-host/db?sslmode=require"

BETTER_AUTH_SECRET="production-secret-min-32-chars"
BETTER_AUTH_URL="https://your-app.vercel.app"

RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="MedicareLab <noreply@yourdomain.com>"