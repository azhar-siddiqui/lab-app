# =============================================================================
# LOCAL DEVELOPMENT
# Copy to `.env.local` and fill in your dev database + secrets.
# =============================================================================

# Dev database (Neon dev branch, local Postgres, etc.)
DATABASE_URL="postgresql://user:password@dev-host/db?sslmode=require"

# Optional: direct (non-pooled) URL for `pnpm db:migrate` against dev
# DIRECT_URL="postgresql://user:password@dev-host/db?sslmode=require"

# Auth — local
BETTER_AUTH_SECRET="generate-a-long-random-secret-min-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# Email verification via Resend
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="MedicareLab <noreply@yourdomain.com>"

# ImageKit (optional)
IMAGEKIT_PRIVATE_KEY=""
IMAGEKIT_PUBLIC_KEY=""


# =============================================================================
# PRODUCTION (Vercel — do NOT put production secrets in committed files)
# Set these in: Vercel → Project → Settings → Environment Variables → Production
# =============================================================================
#
# DATABASE_URL     = your production Postgres URL (different from dev)
# DIRECT_URL       = optional direct URL for migrations on Neon
# BETTER_AUTH_SECRET = strong random secret (different from dev)
# BETTER_AUTH_URL  = https://lab-app-ten.vercel.app  (your production URL)
# RESEND_API_KEY
# RESEND_FROM_EMAIL
#
# Run migrations against production once after deploy:
#   DATABASE_URL="<prod-url>" pnpm prisma migrate deploy